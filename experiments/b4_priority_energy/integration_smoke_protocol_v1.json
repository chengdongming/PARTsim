{
  "protocol_name": "B4-PE-I4B-2A-integration-smoke-v1",
  "schema_version": "b4-pe-integration-smoke-v1",
  "record_type": "integration_smoke",
  "fixed_identity": {
    "campaign_result_count": 0,
    "campaign_started": false,
    "execution_scope": "single-real-case",
    "not_for_paper": true,
    "phase": "integration_smoke",
    "selected_case_count": 1
  },
  "record_fields": [
    "schema_version",
    "record_type",
    "phase",
    "execution_scope",
    "selected_case_count",
    "campaign_started",
    "campaign_result_count",
    "not_for_paper",
    "case_id",
    "algorithm",
    "command_argv",
    "simulator_path",
    "output_root",
    "system_config_path",
    "taskset_path",
    "source_artifact_path",
    "result_relpath",
    "timeout_seconds",
    "retry_policy",
    "provenance"
  ],
  "provenance_fields": [
    "generator_path",
    "generator_sha256",
    "generator_argv",
    "taskset_raw_sha256",
    "taskset_semantic_hash",
    "system_config_sha256",
    "source_artifact_sha256",
    "simulator_sha256"
  ],
  "path_rules": {
    "artifact_paths": "canonical_relative_below_output_root",
    "campaign_path_fragments_forbidden": [
      "results/pilot",
      "results/formal",
      "results/negative"
    ],
    "output_root": "absolute_resolved_outside_repository",
    "record_file": "single_regular_file_outside_repository",
    "result_prefix": "integration-smoke/results/",
    "simulator_path": "absolute"
  },
  "command_rules": {
    "argument_source": "validated_record_command_argv_only",
    "result_occurrences": 1,
    "semantic_hash_occurrences": 1,
    "simulator_occurrences": 1,
    "source_transport": "record_field_once_then_i4b1_B4PE_SOURCE_SNAPSHOT",
    "system_occurrences": 1,
    "taskset_occurrences": 1,
    "test_argument_hook": false
  },
  "retry_rules": {
    "allowed_retry_on": [
      "timeout"
    ],
    "max_attempts": 2,
    "on_final_failure": "fail_closed"
  },
  "gateway_rules": {
    "campaign_summary": false,
    "formal_validator_for_smoke": false,
    "identity_protocol_mutation": false,
    "production_validator_injection": false,
    "smoke_validator_for_formal": false,
    "validated_case_count": 1
  }
}
