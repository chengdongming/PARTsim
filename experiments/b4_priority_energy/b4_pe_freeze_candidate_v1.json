        "purpose": "_template_power_contract, _release_count, and materialize_taskset are the current executable reference for the synchronous smoke bridge."
      }
    ],
    "input_fields": {
      "C_i": "task.runtime",
      "H": "manifest.horizon_ms",
      "O_i": "integer parsed from task.params.arrival_offset",
      "T_i": "task.iat",
      "lambda_E": "manifest.lambda_E",
      "p0_w": "system.energy_management.scheduler_energy_model.base_power multiplied by system.energy_management.scheduler_energy_model.workload_coefficients.hash and system.energy_management.scheduler_energy_model.frequency_power_ratios[system.cpu_islands[0].base_freq]",
      "rho_reference": "2",
      "task_id": "integer suffix in the frozen task.name form task_<task_id>"
    },
    "invalid_alpha_policy": "If alpha_w is negative, reject and regenerate the taskset; do not clamp it.",
    "rho_reference": 2,
    "rm_priority_order": {
      "T_i_field": "task.iat",
      "primary_order": "T_i ascending",
      "sort_key": "(T_i, task_id)",
      "task_id_source": "integer suffix in the frozen task.name form task_<task_id>",
      "tie_break": "task_id ascending when T_i is equal"
    },
    "rules": {
      "E0_j": "E_burst_ref_j",
      "E_burst_ref_j": "sum_{i in RM top 4} C_i*q0_j_per_ms*a_ref",
      "E_dem_nom_j": "E_dem_nom_j(H)=W_H_j+W_L_j",
      "Emax_j": "2*E_burst_ref_j",
      "N_i": "N_i(H)=0 if O_i>=H else floor((H-1-O_i)/T_i)+1",
      "W_H_j": "sum_{i in RM top 4} N_i(H)*C_i*q0_j_per_ms",
      "W_L_j": "sum_{i in RM bottom 6} N_i(H)*C_i*q0_j_per_ms",
      "a_ref": "2*b_ref",
      "alpha_w": "(lambda_E*E_dem_nom_j(H)-E0_j)/22",
      "b_ref": "(W_H_j+W_L_j)/(2*W_H_j+W_L_j)",
      "p0_w": "base_power_w*workload_coefficients.hash*frequency_power_ratios[base_freq]",
      "q0_j_per_ms": "p0_w/1000"
    },
    "uniquely_recoverable": true
  },
